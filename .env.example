# SharBo Globo local/BYOK configuration

# Required for the default open-source runtime
TAVILY_API_KEY=

# Default pipeline
NEWS_DISCOVERY_PROVIDER=tavily
INTELLIGENCE_MODE=deterministic

# Optional Tavily tuning
TAVILY_DISCOVERY_DEPTH=basic
TAVILY_VERIFICATION_DEPTH=basic
TAVILY_DISCOVERY_MAX_RESULTS=12
TAVILY_VERIFICATION_MAX_RESULTS=8
TAVILY_MIN_RELEVANCE_SCORE=0.20

# Optional enhanced intelligence mode only
OPENAI_API_KEY=
OPENAI_FINAL_MODEL=gpt-5.6
